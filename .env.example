# Railway provides MYSQL_URL or DATABASE_URL. Locally, use the fields below.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=e_perpustakaan
DB_USER=root
DB_PASSWORD=

JWT_SECRET=replace-with-a-long-random-secret
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
SCHOOL_LOAN_DURATION_DAYS=7
SCHOOL_SETTINGS_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-characters

# Optional Kasera Pay credential fallback; credentials can also be saved encrypted
# through Super Admin > QRIS & Harga.
# Add https://<public-api-domain>/api/payments/kasera/webhook in the matching Kasera mode.
KASERA_API_KEY=
KASERA_WEBHOOK_SECRET=

# Used only by `npm run seed:admin`
SUPER_ADMIN_NAME=Platform Owner
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
