{
  "name": "e-perpustakaan-saas",
  "version": "1.0.0",
  "private": true,
  "description": "SaaS e-Perpustakaan sekolah multi-tenant",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "db:setup": "npm run db:setup --prefix server",
    "seed:admin": "npm run seed:admin --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
